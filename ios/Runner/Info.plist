<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OKF Buddy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>auto_explore</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- ==== file_picker: allows FileType.custom document picking (e.g. .trailblazer) ==== -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Declare the custom .trailblazer UTI so iOS knows this app owns it.
	     Without UTImportedTypeDeclarations the file appears greyed-out in the
	     document picker even when FileType.custom + allowedExtensions is set. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.okfbuddy.trailblazer-backup</string>
			<key>UTTypeDescription</key>
			<string>Trailblazer Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.database</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>trailblazer</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Register the document type so the app can be offered as a handler when
	     the user taps a .trailblazer file in Files / Mail / AirDrop. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Trailblazer Backup</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.okfbuddy.trailblazer-backup</string>
			</array>
		</dict>
	</array>
	<!-- ==== Trailblazer permission strings ==== -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Trailblazer records your route while you drive to show which roads you've explored.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Trailblazer records trips in the background so you never miss a road you've driven.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Trailblazer needs Always location access to record trips while your phone is locked.</string>
	<key>NSMotionUsageDescription</key>
	<string>Trailblazer uses motion sensors to detect when you start and stop driving.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Trailblazer can use your car's Bluetooth connection to automatically detect which vehicle you're driving.</string>
	<key>NSBluetoothCentralUsageDescription</key>
	<string>Trailblazer can use Bluetooth to detect your vehicle.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
		<string>fetch</string>
	</array>
	<!-- ==== end Trailblazer ==== -->
</dict>
</plist>
